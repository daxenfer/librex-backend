<Project>

  <!-- Lo que los cinco proyectos comparten. Vive aquí para que cambiar de versión de .NET
       sea una sola edición y no cinco, y para que ningún proyecto se quede atrás. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Analizadores. TreatWarningsAsErrors se activa porque el build está en cero advertencias:
       a partir de aquí, dejar entrar una es una decisión consciente y no un descuido. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
